{
  "$description": "Tier 2 - semantic colour tokens for the light theme. Must define exactly the same keys as the other theme files.",
  "color": {
    "$type": "color",
    "background": {
      "$value": "{color.slate.50}",
      "$description": "App/page background behind all surfaces."
    },
    "surface": {
      "$value": "{color.white}"
    },
    "surfaceRaised": {
      "$value": "{color.white}",
      "$description": "Cards, sheets and other elevated containers."
    },
    "surfaceSunken": {
      "$value": "{color.slate.100}"
    },
    "primary": {
      "$value": "{color.blue.600}"
    },
    "onPrimary": {
      "$value": "{color.white}"
    },
    "primaryContainer": {
      "$value": "{color.blue.100}"
    },
    "onPrimaryContainer": {
      "$value": "{color.blue.900}"
    },
    "secondary": {
      "$value": "{color.slate.700}"
    },
    "onSecondary": {
      "$value": "{color.white}"
    },
    "text": {
      "primary": {
        "$value": "{color.slate.900}"
      },
      "secondary": {
        "$value": "{color.slate.600}",
        "$description": "Supporting text; must keep >= 4.5:1 contrast on surface."
      },
      "disabled": {
        "$value": "{color.slate.400}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.slate.200}"
      },
      "strong": {
        "$value": "{color.slate.300}"
      },
      "focus": {
        "$value": "{color.blue.600}",
        "$description": "Focus ring colour for keyboard navigation."
      }
    },
    "success": {
      "$value": "{color.green.700}"
    },
    "onSuccess": {
      "$value": "{color.white}"
    },
    "warning": {
      "$value": "{color.amber.700}"
    },
    "onWarning": {
      "$value": "{color.white}"
    },
    "danger": {
      "$value": "{color.red.600}"
    },
    "onDanger": {
      "$value": "{color.white}"
    },
    "disabled": {
      "background": {
        "$value": "{color.slate.100}"
      },
      "foreground": {
        "$value": "{color.slate.400}"
      }
    },
    "state": {
      "hover": {
        "$value": "{color.alpha.black8}",
        "$description": "Overlay painted on interactive elements while hovered."
      },
      "pressed": {
        "$value": "{color.alpha.black12}",
        "$description": "Overlay painted on interactive elements while pressed."
      },
      "focus": {
        "$value": "{color.alpha.black12}"
      }
    }
  }
}

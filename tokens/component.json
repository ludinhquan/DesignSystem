{
  "$description": "Tier 3 - component tokens. Only add a token here when a component needs to diverge from the semantic tier.",
  "button": {
    "$type": "dimension",
    "heightSm": {
      "$value": "{space.8}"
    },
    "heightMd": {
      "$value": "{space.10}"
    },
    "heightLg": {
      "$value": "{space.12}"
    },
    "paddingXSm": {
      "$value": "{space.sm}"
    },
    "paddingXMd": {
      "$value": "{space.md}"
    },
    "paddingXLg": {
      "$value": "{space.lg}"
    },
    "gap": {
      "$value": "{space.xs}"
    },
    "radius": {
      "$value": "{radius.md}"
    },
    "borderWidth": {
      "$value": "{borderWidth.thin}"
    },
    "focusRingWidth": {
      "$value": "{borderWidth.thick}",
      "$description": "Width of the keyboard focus ring."
    },
    "iconSize": {
      "$value": "{size.iconSm}"
    },
    "spinnerStroke": {
      "$value": "{borderWidth.thick}"
    }
  },
  "card": {
    "$type": "dimension",
    "padding": {
      "$value": "{space.md}"
    },
    "radius": {
      "$value": "{radius.lg}"
    },
    "borderWidth": {
      "$value": "{borderWidth.thin}"
    },
    "gap": {
      "$value": "{space.xs}"
    }
  }
}

{
  "$description": "Tier 1 - primitive (reference) tokens. Raw values with no meaning. Components must never read these directly.",
  "color": {
    "$type": "color",
    "white": { "$value": "#FFFFFF" },
    "black": { "$value": "#000000" },
    "slate": {
      "50": { "$value": "#F8FAFC" },
      "100": { "$value": "#F1F5F9" },
      "200": { "$value": "#E2E8F0" },
      "300": { "$value": "#CBD5E1" },
      "400": { "$value": "#94A3B8" },
      "500": { "$value": "#64748B" },
      "600": { "$value": "#475569" },
      "700": { "$value": "#334155" },
      "800": { "$value": "#1E293B" },
      "900": { "$value": "#0F172A" },
      "950": { "$value": "#020617" }
    },
    "blue": {
      "50": { "$value": "#EFF6FF" },
      "100": { "$value": "#DBEAFE" },
      "200": { "$value": "#BFDBFE" },
      "300": { "$value": "#93C5FD" },
      "400": { "$value": "#60A5FA" },
      "500": { "$value": "#3B82F6" },
      "600": { "$value": "#2563EB" },
      "700": { "$value": "#1D4ED8" },
      "800": { "$value": "#1E40AF" },
      "900": { "$value": "#1E3A8A" }
    },
    "green": {
      "100": { "$value": "#DCFCE7" },
      "300": { "$value": "#86EFAC" },
      "600": { "$value": "#16A34A" },
      "700": { "$value": "#15803D" },
      "900": { "$value": "#14532D" }
    },
    "amber": {
      "100": { "$value": "#FEF3C7" },
      "300": { "$value": "#FCD34D" },
      "500": { "$value": "#F59E0B" },
      "700": { "$value": "#B45309" },
      "900": { "$value": "#78350F" }
    },
    "red": {
      "100": { "$value": "#FEE2E2" },
      "300": { "$value": "#FCA5A5" },
      "600": { "$value": "#DC2626" },
      "700": { "$value": "#B91C1C" },
      "900": { "$value": "#7F1D1D" }
    },
    "alpha": {
      "$description": "Translucent overlays used for interaction state layers.",
      "black8": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.08, "hex": "#000000" }
      },
      "black12": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12, "hex": "#000000" }
      },
      "white8": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.08, "hex": "#FFFFFF" }
      },
      "white12": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.12, "hex": "#FFFFFF" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4pt spacing scale.",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "14": { "$value": { "value": 56, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "borderWidth": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "thick": { "$value": { "value": 2, "unit": "px" } }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": { "value": 12, "unit": "px" } },
    "sm": { "$value": { "value": 14, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 18, "unit": "px" } },
    "xl": { "$value": { "value": 22, "unit": "px" } },
    "xxl": { "$value": { "value": 28, "unit": "px" } },
    "xxxl": { "$value": { "value": 36, "unit": "px" } }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "lineHeight": {
    "$type": "number",
    "$description": "Line height as a multiple of the font size.",
    "tight": { "$value": 1.2 },
    "snug": { "$value": 1.35 },
    "normal": { "$value": 1.5 }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tight": { "$value": { "value": -0.25, "unit": "px" } },
    "normal": { "$value": { "value": 0, "unit": "px" } },
    "wide": { "$value": { "value": 0.1, "unit": "px" } }
  }
}

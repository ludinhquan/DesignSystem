  "loginTitle": "Sign in to {appName}",
  "@loginTitle": {
    "description": "Login screen heading.",
    "placeholders": { "appName": { "type": "String", "example": "Acme" } }
  },
  "loginEmail": "Email",
  "@loginEmail": { "description": "Email field label." },
  "loginPassword": "Password",
  "@loginPassword": { "description": "Password field label." },
  "loginSubmit": "Sign in",
  "@loginSubmit": { "description": "Login button." },

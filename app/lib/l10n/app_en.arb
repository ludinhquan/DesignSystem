  "errorInvalidCredentials": "Wrong email or password.",
  "@errorInvalidCredentials": { "description": "UnauthorizedException on the login screen." },
  "errorServer": "The server is having trouble. Please try again later.",
  "@errorServer": { "description": "ServerException (5xx)." },
  "errorRequest": "The request could not be completed.",
  "@errorRequest": { "description": "RequestException (other 4xx)." },
  "errorUnknown": "Something went wrong. Please try again.",
